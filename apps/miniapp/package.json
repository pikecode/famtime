{
  "name": "miniapp",
  "version": "1.0.0",
  "private": true,
  "description": "家庭共享日历小程序",
  "templateInfo": {
    "name": "default",
    "typescript": true,
    "css": "less"
  },
  "scripts": {
    "dev:weapp": "NODE_ENV=development taro build --type weapp --watch",
    "build:weapp": "NODE_ENV=production taro build --type weapp",
    "dev:h5": "NODE_ENV=development taro build --type h5 --watch",
    "build:h5": "NODE_ENV=production taro build --type h5"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.23.0",
    "@tarojs/components": "3.6.22",
    "@tarojs/helper": "3.6.22",
    "@tarojs/plugin-framework-react": "3.6.22",
    "@tarojs/plugin-platform-weapp": "3.6.22",
    "@tarojs/react": "3.6.22",
    "@tarojs/runtime": "3.6.22",
    "@tarojs/shared": "3.6.22",
    "@tarojs/taro": "3.6.22",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "zustand": "^4.4.0",
    "@famtime/shared": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@tarojs/cli": "3.6.22",
    "@tarojs/webpack5-runner": "3.6.22",
    "@types/react": "^18.2.0",
    "babel-preset-taro": "3.6.22",
    "less": "^4.2.0",
    "typescript": "^5.3.0",
    "webpack": "^5.89.0"
  }
}
