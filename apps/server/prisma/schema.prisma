generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  unionid   String?
  nickname  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  createdFamilies Family[]       @relation("FamilyCreator")
  adminFamilies   Family[]       @relation("FamilyAdmin")
  memberships     FamilyMember[]
  createdEvents   Event[]        @relation("EventCreator")
  assignedEvents  Event[]        @relation("EventAssignee")
  reminderPrefs   ReminderPreference?
  comments        EventComment[]
  notifications   Notification[]
  templates       EventTemplate[]
  achievements    UserAchievement[]
  stats           UserStats?

  @@map("users")
}

// 家庭表
model Family {
  id         String   @id @default(cuid())
  name       String
  avatar     String?
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 创建者和管理员
  creatorId String
  creator   User   @relation("FamilyCreator", fields: [creatorId], references: [id])
  adminId   String
  admin     User   @relation("FamilyAdmin", fields: [adminId], references: [id])

  // 关系
  members FamilyMember[]
  events  Event[]
  memories FamilyMemory[]
  templates EventTemplate[]

  @@map("families")
}

// 家庭成员表
model FamilyMember {
  id       String   @id @default(cuid())
  nickname String
  role     MemberRole @default(MEMBER)
  color    String   @default("#339AF0")
  joinedAt DateTime @default(now())

  // 关系
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

// 事件/日程表
model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  isAllDay    Boolean     @default(false)
  category    EventCategory @default(OTHER)
  visibility  Visibility  @default(FAMILY)
  status      EventStatus @default(CONFIRMED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 重复规则
  isRecurring     Boolean @default(false)
  recurrenceRule  String? // 简化的重复规则: "DAILY|WEEKLY|MONTHLY|YEARLY"
  recurrenceEnd   DateTime? // 重复结束日期
  recurrenceCount Int? // 重复次数
  recurrenceData  Json? // 额外数据: {weekdays: [1,3,5], monthDay: 15}

  // 重复事件关系
  seriesMasterId String? // 如果是重复事件的实例，指向主事件
  seriesMaster   Event?  @relation("EventSeries", fields: [seriesMasterId], references: [id], onDelete: Cascade)
  seriesInstances Event[] @relation("EventSeries")
  originalDate   DateTime? // 原始日期（用于编辑单个实例）

  // 关系
  familyId   String
  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User   @relation("EventCreator", fields: [creatorId], references: [id])
  assigneeId String?
  assignee   User?  @relation("EventAssignee", fields: [assigneeId], references: [id])

  // 提醒
  reminders EventReminder[]
  comments  EventComment[]

  @@index([familyId, startTime])
  @@index([assigneeId, status])
  @@index([seriesMasterId])
  @@map("events")
}

// 事件提醒表
model EventReminder {
  id            String      @id @default(cuid())
  type          ReminderType @default(AT_TIME)
  beforeMinutes Int?
  scheduledAt   DateTime
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  // 关系
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@map("event_reminders")
}

// 用户提醒偏好
model ReminderPreference {
  id                      String   @id @default(cuid())
  quietHoursStart         String?  // "22:00"
  quietHoursEnd           String?  // "08:00"
  allowImportantOverride  Boolean  @default(true)
  defaultReminders        Json     @default("[]")
  updatedAt               DateTime @updatedAt

  // 关系
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_preferences")
}

// 事件评论表
model EventComment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userId  String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@map("event_comments")
}

// 家庭回忆录表
model FamilyMemory {
  id        String   @id @default(cuid())
  type      MemoryType @default(MONTHLY)
  period    String   // "2024-01" for monthly, "2024" for yearly
  title     String
  summary   String   @db.Text
  coverImage String?
  eventCount Int     @default(0)
  highlights Json    @default("[]") // 重要事件摘要
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@unique([familyId, type, period])
  @@index([familyId, period])
  @@map("family_memories")
}

// 通知记录表
model Notification {
  id        String           @id @default(cuid())
  type      NotificationType
  title     String
  content   String
  data      Json?            // 额外数据，如 eventId, familyId 等
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  // 关系
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

// 日程模板表
model EventTemplate {
  id          String        @id @default(cuid())
  name        String                        // 模板名称
  title       String                        // 日程标题
  description String?                       // 描述
  duration    Int?                          // 持续时间（分钟）
  isAllDay    Boolean       @default(false) // 是否全天
  category    EventCategory @default(OTHER) // 分类
  visibility  Visibility    @default(FAMILY) // 可见性
  reminders   Json          @default("[]")  // 提醒设置
  isPublic    Boolean       @default(false) // 是否公开（家庭共享）
  usageCount  Int           @default(0)     // 使用次数
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // 关系
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId String
  creator   User   @relation(fields: [creatorId], references: [id])

  @@index([familyId, isPublic])
  @@map("event_templates")
}

// 枚举类型
enum MemberRole {
  ADMIN
  MEMBER
}

enum EventCategory {
  BIRTHDAY
  ANNIVERSARY
  HEALTH
  FAMILY_ACTIVITY
  REMINDER
  OTHER
}

enum Visibility {
  PRIVATE
  FAMILY
}

enum EventStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ReminderType {
  AT_TIME
  BEFORE
}

enum MemoryType {
  MONTHLY
  YEARLY
  ANNIVERSARY
}

enum NotificationType {
  EVENT_REMINDER    // 日程提醒
  EVENT_INVITE      // 日程邀请
  FAMILY_INVITE     // 家庭邀请
  MONTHLY_MEMORY    // 月度回忆
  SYSTEM            // 系统通知
}

// 成就定义表
model Achievement {
  id          String              @id @default(cuid())
  key         String              @unique
  name        String
  description String
  icon        String
  category    AchievementCategory
  type        AchievementType
  target      Int
  points      Int                 @default(10)
  order       Int                 @default(0)
  createdAt   DateTime            @default(now())

  userAchievements UserAchievement[]

  @@map("achievements")
}

// 用户成就表
model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  progress      Int       @default(0)
  isCompleted   Boolean   @default(false)
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, isCompleted])
  @@map("user_achievements")
}

// 用户统计表
model UserStats {
  id              String    @id @default(cuid())
  userId          String    @unique
  totalEvents     Int       @default(0)
  totalComments   Int       @default(0)
  totalMemories   Int       @default(0)
  eventsForOthers Int       @default(0)
  acceptedEvents  Int       @default(0)
  currentStreak   Int       @default(0)
  longestStreak   Int       @default(0)
  lastEventDate   DateTime?
  totalPoints     Int       @default(0)
  // 分类统计
  birthdayEvents       Int @default(0)
  anniversaryEvents    Int @default(0)
  healthEvents         Int @default(0)
  familyActivityEvents Int @default(0)
  reminderEvents       Int @default(0)
  otherEvents          Int @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_stats")
}

enum AchievementCategory {
  ONBOARDING
  EVENT
  FAMILY
  STREAK
  MEMORY
  SPECIAL
}

enum AchievementType {
  ONE_TIME
  CUMULATIVE
  STREAK
}
