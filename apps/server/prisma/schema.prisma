generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户表
model User {
  id        String   @id @default(cuid())
  openid    String   @unique
  unionid   String?
  nickname  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  createdFamilies Family[]       @relation("FamilyCreator")
  adminFamilies   Family[]       @relation("FamilyAdmin")
  memberships     FamilyMember[]
  createdEvents   Event[]        @relation("EventCreator")
  assignedEvents  Event[]        @relation("EventAssignee")
  reminderPrefs   ReminderPreference?

  @@map("users")
}

// 家庭表
model Family {
  id         String   @id @default(cuid())
  name       String
  avatar     String?
  inviteCode String   @unique
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // 创建者和管理员
  creatorId String
  creator   User   @relation("FamilyCreator", fields: [creatorId], references: [id])
  adminId   String
  admin     User   @relation("FamilyAdmin", fields: [adminId], references: [id])

  // 关系
  members FamilyMember[]
  events  Event[]

  @@map("families")
}

// 家庭成员表
model FamilyMember {
  id       String   @id @default(cuid())
  nickname String
  role     MemberRole @default(MEMBER)
  color    String   @default("#339AF0")
  joinedAt DateTime @default(now())

  // 关系
  familyId String
  family   Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([familyId, userId])
  @@map("family_members")
}

// 事件/日程表
model Event {
  id          String      @id @default(cuid())
  title       String
  description String?
  startTime   DateTime
  endTime     DateTime?
  isAllDay    Boolean     @default(false)
  category    EventCategory @default(OTHER)
  visibility  Visibility  @default(FAMILY)
  status      EventStatus @default(CONFIRMED)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  // 重复规则 (JSON)
  recurrence  Json?

  // 关系
  familyId   String
  family     Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  creatorId  String
  creator    User   @relation("EventCreator", fields: [creatorId], references: [id])
  assigneeId String?
  assignee   User?  @relation("EventAssignee", fields: [assigneeId], references: [id])

  // 提醒
  reminders EventReminder[]

  @@index([familyId, startTime])
  @@index([assigneeId, status])
  @@map("events")
}

// 事件提醒表
model EventReminder {
  id            String      @id @default(cuid())
  type          ReminderType @default(AT_TIME)
  beforeMinutes Int?
  scheduledAt   DateTime
  sentAt        DateTime?
  createdAt     DateTime    @default(now())

  // 关系
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([scheduledAt, sentAt])
  @@map("event_reminders")
}

// 用户提醒偏好
model ReminderPreference {
  id                      String   @id @default(cuid())
  quietHoursStart         String?  // "22:00"
  quietHoursEnd           String?  // "08:00"
  allowImportantOverride  Boolean  @default(true)
  defaultReminders        Json     @default("[]")
  updatedAt               DateTime @updatedAt

  // 关系
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminder_preferences")
}

// 枚举类型
enum MemberRole {
  ADMIN
  MEMBER
}

enum EventCategory {
  BIRTHDAY
  ANNIVERSARY
  HEALTH
  FAMILY_ACTIVITY
  REMINDER
  OTHER
}

enum Visibility {
  PRIVATE
  FAMILY
}

enum EventStatus {
  PENDING
  CONFIRMED
  REJECTED
  CANCELLED
}

enum ReminderType {
  AT_TIME
  BEFORE
}
