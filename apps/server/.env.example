# 数据库
DATABASE_URL="postgresql://postgres:password@localhost:5432/famtime?schema=public"

# JWT
JWT_SECRET="your-jwt-secret-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# 微信小程序
WECHAT_APPID="wxb9607da16fecda68"
WECHAT_SECRET="your-wechat-secret"

# 微信订阅消息模板 ID
WECHAT_TEMPLATE_EVENT_REMINDER="your-event-reminder-template-id"
WECHAT_TEMPLATE_FAMILY_INVITE="your-family-invite-template-id"
WECHAT_TEMPLATE_MONTHLY_MEMORY="your-monthly-memory-template-id"

# 服务器配置
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="*"

# OpenAI (用于智能文案生成 - 可选)
OPENAI_API_KEY="your-openai-api-key"
OPENAI_MODEL="gpt-3.5-turbo"
